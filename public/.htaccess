# Agenda Flui (web) — hospedagem Apache/LiteSpeed da Hostinger.
# O `npx expo export` copia este arquivo de public/ para a raiz do site.

Options -Indexes
DirectoryIndex index.html

AddType application/javascript .js
AddType application/json .json .map
AddType font/ttf .ttf
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sempre HTTPS (o pagamento só volta para endereço https liberado na chave do app).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Arquivo que existe é servido como está.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Arquivo estático que falta dá 404 (não devolve a página no lugar de um script).
  RewriteRule ^(_expo|assets)/ - [R=404,L]

  # Arquivo de associação que falta dá 404 (não devolve a página no lugar do JSON).
  RewriteRule ^\.well-known/ - [R=404,L]

  # Qualquer outra rota (/<loja>, /<loja>/pedidos/<id>) abre o app.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Página e manifesto: sempre conferem a versão nova.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Associação do link https com o app (iOS e Android): JSON, sempre conferido de novo.
  <Files "apple-app-site-association">
    ForceType application/json
  </Files>
  <FilesMatch "^(apple-app-site-association|assetlinks\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Scripts e assets do Expo têm o hash no nome: podem ficar um ano em cache.
  <FilesMatch "\.(js|css|ttf|woff2?|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "favicon.ico">
    Header set Cache-Control "public, max-age=86400"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
